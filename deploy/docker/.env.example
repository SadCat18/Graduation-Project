APP_PORT=80
SERVER_NAME=_
CORS_ALLOWED_ORIGINS=https://your-domain.example

MYSQL_ROOT_PASSWORD=ChangeThisRootPassword
MYSQL_DATABASE=skate_exchange
MYSQL_USER=appuser
MYSQL_PASSWORD=ChangeThisAppPassword

# Optional external MySQL target (for example Tencent CDB). Leave blank to use the Compose MySQL service.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

REDIS_PASSWORD=

JWT_SECRET=ChangeThisToAtLeast32CharsLongRandomSecret
JWT_EXPIRATION_HOURS=24

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_DEFAULT_PASSWORD=

FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
JPA_DDL_AUTO=none

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_FAILURE_DENIES_PROTECTED=true

# AI 网关（火山方舟 Ark；其他 OpenAI 兼容厂商改 AI_BASE_URL_DEFAULT 即可）
AI_PROVIDER_DEFAULT=ark
AI_MODEL_DEFAULT=doubao-seed-2-1-lite-260915
AI_BASE_URL_DEFAULT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_API_KEY_DEFAULT=你的ARK_API_KEY
# 如需整体覆盖默认分组（优先级高于 *_DEFAULT），取消注释：
# AI_PROVIDER=
# AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=
# 资讯场景专用分组（不填则继承默认分组）：
# AI_PROVIDER_NEWS=
# AI_MODEL_NEWS=
# AI_BASE_URL_NEWS=
# AI_API_KEY_NEWS=
# AI 老师对话场景覆写（默认沿用默认网关和密钥）
# AI_PROVIDER_COACH_CHAT=
# AI_MODEL_COACH_CHAT=doubao-seed-evolving

AMAP_KEY=
AMAP_SERVICE_HOST=
AMAP_SECURITY_JS_CODE=
